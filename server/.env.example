# ============================================================
# FoodSchool — Variáveis de Ambiente (Backend)
# Copie este arquivo para .env e ajuste os valores
# ============================================================

# Porta do servidor API
PORT=3001

# Caminho do banco de dados SQLite (relativo a server/)
# Ex.: ./data/escola.db
DB_PATH=./data/escola.db

# Segredo JWT — use um valor longo e aleatório:
# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Se não definido, o sistema gera um segredo aleatório a cada reinício
# (isso invalida tokens após reiniciar o servidor — defina para sessões persistirem)
JWT_SECRET=crie_um_segredo_longo_e_secreto_aqui

# Custo do hash bcrypt (quanto maior, mais seguro e lento)
# Recomendado: 10 a 12
BCRYPT_ROUNDS=10

# Proteção contra brute-force no login
# Máximo de tentativas antes de bloquear a conta temporariamente
MAX_LOGIN_ATTEMPTS=5
# Tempo de bloqueio em minutos
LOGIN_LOCK_MINUTES=5

# Limite global de requisições por janela de 15 minutos
RATE_LIMIT_MAX=300

# Ambiente: development | production
# Em production, o HSTS é ativado
NODE_ENV=development
