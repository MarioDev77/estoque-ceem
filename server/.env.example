# ============================================================
# Configuração do MySQL (Railway / outros provedores)
# ============================================================
# Copie este arquivo para ".env" e preencha com os dados do seu banco.
# No Railway, as variáveis do serviço MySQL são injetadas automaticamente
# quando você referencia o serviço de banco no deploy do backend.

# Formato 1 — URL completa do MySQL (prioridade mais alta)
# O Railway gera "URL_MYSQL" ou "MYSQL_PRIVATE_URL" automaticamente.
# Ex.: mysql://usuario:senha@host:3306/nome_do_banco
MYSQL_PRIVATE_URL=
# ou
URL_MYSQL=

# Formato 2 — Variáveis separadas (Railway)
# O Railway preenche estas variáveis automaticamente:
MYSQLHOST=
MYSQLPORT=3306
MYSQLDATABASE=
MYSQLUSER=
MYSQLPASSWORD=

# Formato 3 — Variáveis separadas (padrão / genérico)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Formato 4 — Variáveis em português (Railway)
USUARIO_MYSQL=
SENHA_ROOT_DO_MYSQL=
SENHA_DO_MYSQL=

# ============================================================
# Outras variáveis do sistema
# ============================================================
PORT=3001
JWT_SECRET=troque-este-segredo
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=5
RATE_LIMIT_MAX=300
