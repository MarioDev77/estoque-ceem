# ============================================================
# Configuração do MySQL (Railway / qualquer provedor)
# ============================================================
# O servidor aceita QUALQUER um dos formatos abaixo.
# Preencha apenas UM deles (o primeiro encontrado será usado).

# --- Opção 1: URL completa (mais comum) ---
# Formato: mysql://usuario:senha@host:porta/banco
# No Railway, use a variável MYSQL_PRIVATE_URL gerada automaticamente
# ao adicionar um serviço MySQL. Copie o valor dela para sua variável.
MYSQL_PRIVATE_URL="mysql://usuario:senha@host:3306/banco"

# URLs alternativas aceitas:
# MYSQL_URL="mysql://usuario:senha@host:3306/banco"
# DATABASE_URL="mysql://usuario:senha@host:3306/banco"
# MYSQL_ADDON_URI="mysql://usuario:senha@host:3306/banco"
# CLEARDB_DATABASE_URL="mysql://usuario:senha@host:3306/banco"
# JAWSDB_URL="mysql://usuario:senha@host:3306/banco"

# --- Opção 2: Variáveis separadas (Railway) ---
# Se você não usar URL, defina estas variáveis individualmente:
# MYSQLHOST="containers-us-west-xxx.railway.app"
# MYSQLPORT="3306"
# MYSQLDATABASE="railway"
# MYSQLUSER="root"
# MYSQLPASSWORD="sua-senha"

# --- Opção 3: Variáveis separadas (padrão/generico) ---
# MYSQL_HOST="localhost"
# MYSQL_PORT="3306"
# MYSQL_DATABASE="escola"
# MYSQL_USER="root"
# MYSQL_PASSWORD="senha"

# ============================================================
# Outras configurações do servidor
# ============================================================
# Porta da API
PORT=3001

# Segredo do JWT (use um valor forte e secreto)
# JWT_SECRET="troque-por-um-segredo-forte"

# Limite de requisições por 15 min (rate limit)
# RATE_LIMIT_MAX=300

# Força de hash do bcrypt
# BCRYPT_ROUNDS=10

# Bloqueio anti brute-force no login
# MAX_LOGIN_ATTEMPTS=5
# LOGIN_LOCK_MINUTES=5
